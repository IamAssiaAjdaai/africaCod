# Dedicated AES-256-GCM key (base64 32 bytes); tracking is disabled by default.
INTEGRATION_CREDENTIALS_KEY=T0XNbzTdJQIkmyOrD2lN647mXV05WDZGwS6nvlF5oWM=
TRACKING_TEST_MODE=0

# Explicit deployment identity. Staging has separate databases/buckets and may enable mocks.
APP_ENV=development
# Independent HMAC secret for distributed abuse buckets (generate a random 32+ character value).
RATE_LIMIT_KEY=8JJy5MPtb9GHGYJi2DWDNEnvCtHPPxpDLO3Yype436vVOKdzW24k0nuqI2zMr4Jj
# Production trusted reverse proxy MUST overwrite this header and prevent direct-origin access.
CLIENT_IP_HEADER=
# local is development only. Production requires private S3-compatible storage.
MEDIA_STORAGE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional pair: Google Cloud web OAuth client; activation requires both.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# required defaults to optional tracking OFF until a signed preference is saved.
# merchant-managed only when operator has reviewed an external consent boundary.
CONSENT_MODE=required
# Browser tests: optional installed Chrome channel; TEST_DATABASE_URL must end in _test.
PLAYWRIGHT_CHROME_CHANNEL=
