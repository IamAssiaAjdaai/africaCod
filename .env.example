# Copy to .env at the repository root. Never commit .env.
DATABASE_URL=postgresql://africacod:africacod_local@localhost:5433/africacod
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Isolated database; integration tests refuse the application database.
TEST_DATABASE_URL=postgresql://africacod:africacod_local@localhost:5433/africacod_test

# Dedicated encryption key; generate with openssl rand -base64 32. No auth-secret fallback.
PROVIDER_CREDENTIALS_KEY=
# Explicit test adapter only. Production ShipCOD is BLOCKED pending official API docs.
PROVIDER_TEST_MODE=0
